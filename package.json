{
  "name": "devopsdays-switzerland-website",
  "version": "1.0.0",
  "description": "DevOpsDays Zurich website built with Hugo",
  "scripts": {
    "dev": "npm run build:css && hugo server -D --bind 0.0.0.0 -p 1314",
    "prebuild": "npm run build:css && node scripts/generate-sponsor-banner.js",
    "build": "hugo --minify",
    "build:css": "npx @tailwindcss/cli -i ./assets/css/tailwind.css -o ./static/css/tailwind.min.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./assets/css/tailwind.css -o ./static/css/tailwind.min.css --watch",
    "build:preview": "npm run prebuild && hugo --minify --baseURL=/preview/",
    "validate": "html-validate public/**/*.html",
    "lighthouse": "npx -y @lhci/cli@0.15.1 autorun",
    "clean": "rm -rf public resources static/css/tailwind.min.css",
    "generate:banner": "node scripts/generate-sponsor-banner.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dod-zh/web.git"
  },
  "keywords": [
    "devops",
    "conference",
    "switzerland",
    "hugo",
    "static-site"
  ],
  "author": "DevOpsDays Zurich Team",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "canvas": "^3.2.3",
    "html-validate": "^11.17.0",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": ">=18"
  }
}
